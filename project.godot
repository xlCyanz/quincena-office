; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Quincena Office"
config/description="Juego de gestión de oficina: contrata, construye y paga la nómina cada 15 días."
config/version="0.7.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Settings="*res://scripts/autoload/settings.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Economy="*res://scripts/autoload/economy.gd"
OfficeState="*res://scripts/autoload/office_state.gd"
Staff="*res://scripts/autoload/staff.gd"
Projects="*res://scripts/autoload/projects.gd"
Products="*res://scripts/autoload/products.gd"
Bank="*res://scripts/autoload/bank.gd"
Company="*res://scripts/autoload/company.gd"
Events="*res://scripts/autoload/events.gd"
Tutorial="*res://scripts/autoload/tutorial.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Panku="*res://addons/panku_console/console.tscn"
DevTools="*res://scripts/debug/dev_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/panku_console/plugin.cfg", "res://addons/quincena_export/plugin.cfg")

[panku]

disable_on_release=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
